# ai-infra local configuration template.
# Copy to .env and fill local values. Do not commit .env.

# Recipient for the daily news briefing Gmail draft request.
# This exact uppercase key is required by config/delivery.yaml.
AI_INFRA_BRIEFING_TO=your-address@example.com

# Local Ollama server used by shared/models.py.
OLLAMA_BASE_URL=http://localhost:11434

# Keep memory pressure low on a 16GB Mac.
OLLAMA_MAX_LOADED_MODELS=1

# Model execution mode: local_only, low_cost, auto, or quality.
# In Phase 1 all modes still resolve to local models.
MODEL_MODE=local_only
